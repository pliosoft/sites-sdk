---
/**
 * Pliosoft preview-deploy approval banner.
 *
 * Renders only when the build was invoked with PLIOSOFT_PREVIEW=1. The build
 * pipeline in pliosoft/sites-app sets these env vars when generating preview
 * bundles for a proposed change; production builds leave them unset, in which
 * case this component returns null and emits nothing.
 *
 * Build-time env vars consumed:
 *   PLIOSOFT_PREVIEW              "1" to enable rendering
 *   PLIOSOFT_PREVIEW_PR           change id (used only to gate rendering)
 *   PLIOSOFT_PREVIEW_TITLE        human-readable description of the change
 *   PLIOSOFT_PREVIEW_JWT          single-use JWT signed by the orchestrator
 *   PLIOSOFT_PREVIEW_API          orchestrator base URL (defaults to https://sites.pliosoft.co)
 *
 * The banner deliberately shows only the change description — no repository,
 * branch, or pull-request details. Reviewers see a Pliosoft surface, not a
 * GitHub one.
 *
 * Approve/Reject are shown only when the page URL carries the approval key
 * (`?k=...`) from the link Pliosoft Sites shared with the customer. The key is
 * forwarded as form data alongside the JWT; the orchestrator verifies both, so
 * someone who merely guesses the preview hostname gets a view-only banner (and
 * the orchestrator refuses the action server-side regardless). Without
 * JavaScript the banner stays view-only.
 */

// process.env, not import.meta.env: Vite only exposes .env-file and
// PUBLIC_-prefixed vars on import.meta.env, and the pipeline passes these
// through the shell environment. Frontmatter runs in Node at build time
// (static output), so process.env sees them.
const env = process.env;
const isPreview = env.PLIOSOFT_PREVIEW === '1';
const pr = env.PLIOSOFT_PREVIEW_PR;
const title = env.PLIOSOFT_PREVIEW_TITLE;
const jwt = env.PLIOSOFT_PREVIEW_JWT;
const api = env.PLIOSOFT_PREVIEW_API ?? 'https://sites.pliosoft.co';
---
{isPreview && pr && jwt && (
  <aside class="pl-preview-banner" role="region" aria-label="Pliosoft preview">
    <div class="pl-preview-banner__head">
      <span class="pl-preview-banner__label">Preview</span>
      {title ? (
        <span class="pl-preview-banner__title" title={title}>{title}</span>
      ) : (
        <span class="pl-preview-banner__title pl-preview-banner__title--muted">Proposed change</span>
      )}
    </div>

    <p class="pl-preview-banner__note" data-pl-preview-note>
      You're viewing a preview of a proposed change.
    </p>

    <div class="pl-preview-banner__actions" data-pl-preview-actions hidden>
      <form method="post" action={`${api}/_preview/approve`} class="pl-preview-banner__form">
        <input type="hidden" name="jwt" value={jwt} />
        <input type="hidden" name="k" value="" />
        <button type="submit" class="pl-preview-banner__btn pl-preview-banner__btn--approve">
          Approve &amp; Deploy
        </button>
      </form>
      <form method="post" action={`${api}/_preview/reject`} class="pl-preview-banner__form">
        <input type="hidden" name="jwt" value={jwt} />
        <input type="hidden" name="k" value="" />
        <button type="submit" class="pl-preview-banner__btn pl-preview-banner__btn--reject">
          Reject
        </button>
      </form>
    </div>

    <script is:inline>
      (() => {
        var k = new URLSearchParams(location.search).get('k');
        if (!k) return;
        var banner = document.currentScript.closest('.pl-preview-banner');
        if (!banner) return;
        banner.querySelectorAll('input[name="k"]').forEach((input) => {
          input.value = k;
        });
        var actions = banner.querySelector('[data-pl-preview-actions]');
        if (actions) actions.hidden = false;
        var note = banner.querySelector('[data-pl-preview-note]');
        if (note) note.hidden = true;
      })();
    </script>
  </aside>
)}

<style>
  .pl-preview-banner {
    /* Brand-controlled regardless of customer theme. */
    position: fixed;
    bottom: 16px;
    right: 16px;
    z-index: 2147483000;
    width: 360px;
    max-width: calc(100vw - 32px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 16px;
    background: rgba(255, 221, 196, 0.97);
    color: rgba(28, 16, 8, 0.92);
    border: 1px solid rgba(28, 16, 8, 0.18);
    border-left: 4px solid hsla(27, 100%, 50%, 1);
    border-radius: 6px;
    box-shadow:
      0 1px 2px hsla(22, 60%, 18%, 0.18),
      0 8px 24px hsla(22, 70%, 22%, 0.18);
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
    font-size: 13px;
    line-height: 1.45;
  }
  .pl-preview-banner__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pl-preview-banner__label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    color: hsla(27, 100%, 35%, 1);
  }
  .pl-preview-banner__title {
    font-size: 14px;
    font-weight: 600;
    color: rgba(28, 16, 8, 0.92);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    word-break: break-word;
  }
  .pl-preview-banner__title--muted {
    font-weight: 500;
    color: rgba(28, 16, 8, 0.7);
  }
  .pl-preview-banner__note {
    margin: 0;
    font-size: 12px;
    color: rgba(28, 16, 8, 0.65);
  }
  .pl-preview-banner__actions {
    display: flex;
    gap: 8px;
  }
  .pl-preview-banner__form {
    margin: 0;
    flex: 1;
  }
  .pl-preview-banner__btn {
    appearance: none;
    width: 100%;
    border: 1px solid rgba(28, 16, 8, 0.24);
    background: transparent;
    color: inherit;
    padding: 7px 12px;
    border-radius: 4px;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    transition:
      background 200ms cubic-bezier(0.175, 0.885, 0.320, 1.275),
      color 200ms cubic-bezier(0.175, 0.885, 0.320, 1.275);
  }
  .pl-preview-banner__btn:hover {
    background: rgba(28, 16, 8, 0.06);
  }
  .pl-preview-banner__btn--approve {
    background: hsla(27, 100%, 50%, 1);
    color: rgba(255, 245, 232, 1);
    border-color: hsla(27, 100%, 45%, 1);
  }
  .pl-preview-banner__btn--approve:hover {
    background: hsla(27, 100%, 45%, 1);
  }
  @media (max-width: 480px) {
    .pl-preview-banner {
      left: 16px;
      right: 16px;
      bottom: 12px;
      width: auto;
    }
  }
</style>
