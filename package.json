{
  "name": "@pliosoft/sites-sdk",
  "version": "0.1.0",
  "description": "Shared Astro components, layouts, and design tokens for Pliosoft-hosted customer sites.",
  "license": "MIT",
  "author": "Pliosoft",
  "homepage": "https://github.com/pliosoft/sites-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pliosoft/sites-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/pliosoft/sites-sdk/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/components/*.astro"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./components/Layout.astro": "./dist/components/Layout.astro",
    "./components/Nav.astro": "./dist/components/Nav.astro",
    "./components/ContactForm.astro": "./dist/components/ContactForm.astro",
    "./components/Footer.astro": "./dist/components/Footer.astro",
    "./components/PoweredBy.astro": "./dist/components/PoweredBy.astro",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "astro": "^5.0.0",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && node scripts/build.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "ci": "npm run check && npm run typecheck && npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "astro",
    "astro-component",
    "pliosoft",
    "sites",
    "design-system",
    "components"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18.17"
  }
}
